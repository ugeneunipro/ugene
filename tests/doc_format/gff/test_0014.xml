<multi-test>
    <!-- A version directive without its number must not prevent loading annotations. -->
    <create-temp-file url="gff_missing_version.gff" data="##gff-version\nchr1&#9;.&#9;rRNA&#9;1&#9;10&#9;.&#9;+&#9;.&#9;ID=rRNA1\n"/>
    <load-document index="doc" url="gff_missing_version.gff" dir="temp" io="local_file" format="gff" message="Parsing error: invalid header"/>
    <find-object-by-name index="annotations" doc="doc" name="chr1 features" type="OT_ANNOTATIONS"/>
    <find-annotation-by-location index="rRNA" obj="annotations" location="1..10" complement="false"/>
</multi-test>
